<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings (e.g. MonsterASP.NET). App_Data is already a hidden segment in IIS's defaults; re-adding it is a
     duplicate-entry error (500.19), and shared hosts may lock removeServerHeader. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\NationalAirspace.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Media library multi-uploads accept up to 200 MB per request (per-file limits are enforced by the app). -->
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
