@model ProfileModel
@using NationalAirspace.Application.Features.Users
@{
    ViewData["Title"] = L["Account.Profile"];
    var profile = ViewData["Profile"] as UserProfileDto;
}
<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" class="admin-card">
            <h2 class="admin-card-title">@L["Account.Details"]</h2>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label class="form-label" for="email">@L["Field.Email"]</label>
                <input id="email" class="form-control" value="@profile?.Email" dir="ltr" readonly />
            </div>
            <field asp-for="FullName" />
            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @L["Common.Save"]</button>
                <a class="btn btn-light" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> @L["Account.ChangePassword"]</a>
            </div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="admin-card">
            <h2 class="admin-card-title">@L["Account.Access"]</h2>
            <dl class="admin-dl">
                <dt>@L["Field.Role"]</dt>
                <dd>@(profile?.Role is { } role ? L["Role." + role] : "—")</dd>
                <dt>@L["Field.LastLoginAtUtc"]</dt>
                <dd>@(profile?.LastLoginAtUtc is { } last ? Clock.DateTimeText(last) : "—")</dd>
            </dl>
        </div>
    </div>
</div>
