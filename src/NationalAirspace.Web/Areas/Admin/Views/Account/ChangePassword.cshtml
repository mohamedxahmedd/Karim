@model NationalAirspace.Application.Features.Users.ChangePasswordInput
@{
    ViewData["Title"] = L["Account.ChangePassword"];
}
<div class="row">
    <div class="col-lg-7">
        <form method="post" class="admin-card" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <field asp-for="CurrentPassword" type="password" />
            <field asp-for="NewPassword" type="password" hint="Account.PasswordPolicy" />
            <field asp-for="ConfirmPassword" type="password" />
            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-key" aria-hidden="true"></i> @L["Account.ChangePassword"]</button>
                <a class="btn btn-light" asp-action="Profile">@L["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>
