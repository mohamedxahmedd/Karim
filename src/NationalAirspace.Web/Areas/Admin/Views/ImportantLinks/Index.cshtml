@model IReadOnlyList<NationalAirspace.Application.Features.Home.ImportantLinkAdminItem>
@{ ViewData["Title"] = L["AdminNav.ImportantLinks"]; }
@section Actions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> @L["ImportantLinks.Create"]</a>
}
<div class="admin-table-wrap">
    @if (Model.Count == 0)
    {
        <partial name="_TableEmpty" />
    }
    else
    {
        <table class="table admin-table">
            <thead><tr><th scope="col">@L["Field.Title"]</th><th scope="col">@L["Field.Status"]</th><th scope="col">@L["Admin.Order"]</th><th scope="col" class="col-actions"><span class="visually-hidden">@L["Admin.Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>
                            <i class="ph-light @(x.Icon ?? "ph-link-simple") text-primary me-1" aria-hidden="true"></i> <a class="row-title" asp-action="Edit" asp-route-id="@x.Id">@Bilingual.Pick(x.TitleAr, x.TitleEn)</a>
                            <span class="row-sub" dir="ltr">@x.Url</span>
                        </td>
                        <td data-label="@L["Field.Status"]"><partial name="_ActiveBadge" model="x.IsActive" /></td>
                        <td data-label="@L["Admin.Order"]"><partial name="_MoveButtons" model="x.Id" /></td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <partial name="_EditLink" model="x.Id" />
                                <post-button asp-action="Delete" asp-route-id="@x.Id.ToString()" icon="bi-trash" title="Common.Delete" class="btn btn-sm btn-outline-danger" confirm="Admin.ConfirmDelete" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
