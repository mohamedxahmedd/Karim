@model AdminFormModel<NationalAirspace.Application.Features.Home.StatisticInput>
@{ ViewData["Title"] = Model.IsNew ? L["Statistics.Create"] : L["Statistics.Edit"]; }
<form method="post" asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.Input.Id" novalidate>
    <input type="hidden" asp-for="Input.ConcurrencyStamp" />
    <div class="row">
        <div class="col-xl-8">
            <div class="admin-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="alert alert-warning small d-flex gap-2"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>@L["Statistics.AccuracyNotice"]</div></div>
                <field asp-for="Input.Value" dir="ltr" hint="Statistics.ValueHint" />
                <div class="row">
                    <div class="col-md-6"><field asp-for="Input.LabelAr" /></div>
                    <div class="col-md-6"><field asp-for="Input.LabelEn" /></div>
                </div>
                <field asp-for="Input.Icon" dir="ltr" placeholder="Admin.IconPlaceholder" hint="Admin.IconHint" />
                <partial name="_IconPicker" model="new IconPickerModel(Model.Input.Icon)" />
                <field asp-for="Input.IsActive" type="checkbox" />
                <div class="admin-form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @L["Common.Save"]</button>
                    <a class="btn btn-light" asp-action="Index">@L["Common.Cancel"]</a>
                </div>
            </div>
        </div>
    </div>
</form>
