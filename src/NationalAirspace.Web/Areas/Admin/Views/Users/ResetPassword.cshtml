@model NationalAirspace.Application.Features.Users.ResetPasswordInput
@{ ViewData["Title"] = L["Users.ResetPassword"]; ViewData["Subtitle"] = ViewData["UserEmail"]; }
<div class="row">
    <div class="col-xl-7">
        <form method="post" class="admin-card" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <field asp-for="NewPassword" type="password" hint="Account.PasswordPolicy" />
            <field asp-for="ConfirmPassword" type="password" />
            <p class="form-text">@L["Users.ResetHint"]</p>
            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-key" aria-hidden="true"></i> @L["Users.ResetPassword"]</button>
                <a class="btn btn-light" asp-action="Index">@L["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>
