@model AdminFormModel<NationalAirspace.Application.Features.Home.HeroSlideInput>
@{ ViewData["Title"] = Model.IsNew ? L["HeroSlides.Create"] : L["HeroSlides.Edit"]; }
<form method="post" enctype="multipart/form-data" asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.Input.Id" novalidate>
    <input type="hidden" asp-for="Input.ConcurrencyStamp" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="admin-card">
                <partial name="_LangTabsNav" model="false" />
                <div class="tab-content pt-4">
                    <div class="tab-pane fade show active" id="tab-ar" role="tabpanel" tabindex="0">
                        <field asp-for="Input.SubtitleAr" />
                        <field asp-for="Input.TitleAr" />
                        <field asp-for="Input.DescriptionAr" type="textarea" rows="3" />
                        <div class="row">
                            <div class="col-md-6"><field asp-for="Input.PrimaryButtonTextAr" /></div>
                            <div class="col-md-6"><field asp-for="Input.SecondaryButtonTextAr" /></div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab-en" role="tabpanel" tabindex="0">
                        <field asp-for="Input.SubtitleEn" />
                        <field asp-for="Input.TitleEn" />
                        <field asp-for="Input.DescriptionEn" type="textarea" rows="3" />
                        <div class="row">
                            <div class="col-md-6"><field asp-for="Input.PrimaryButtonTextEn" /></div>
                            <div class="col-md-6"><field asp-for="Input.SecondaryButtonTextEn" /></div>
                        </div>
                    </div>
                </div>
                <h3 class="form-section-title">@L["HeroSlides.Links"]</h3>
                <div class="row">
                    <div class="col-md-6"><field asp-for="Input.PrimaryButtonUrl" dir="ltr" hint="Admin.LinkHint" /></div>
                    <div class="col-md-6"><field asp-for="Input.SecondaryButtonUrl" dir="ltr" hint="Admin.LinkHint" /></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="admin-card">
                <h2 class="admin-card-title">@L["Admin.Publishing"]</h2>
                <field asp-for="Input.IsActive" type="checkbox" />
                <media-field asp-for="Input.ImageId" kind="Image" upload="SlideImageUpload" />
                <p class="form-text">@L["HeroSlides.ImageHint"]</p>
            </div>
            <partial name="_FormActions" model="true" />
        </div>
    </div>
</form>
