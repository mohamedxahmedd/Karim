@if (TempData[AdminControllerBase.FlashSuccess] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show d-flex gap-2" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i><div>@ok</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
    </div>
}
@if (TempData[AdminControllerBase.FlashError] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div>@err</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
    </div>
}
