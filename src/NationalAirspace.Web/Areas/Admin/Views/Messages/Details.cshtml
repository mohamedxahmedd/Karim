@model NationalAirspace.Application.Features.Contact.ContactMessageDetail
@{ ViewData["Title"] = Model.Subject; }
@section Actions {
    <a class="btn btn-light" asp-action="Index">@L["AdminNav.Messages"]</a>
}
<div class="row g-4">
    <div class="col-xl-8">
        <article class="admin-card">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <partial name="_MessageStatus" model="Model.Status" />
                <span class="text-muted small">@Clock.DateTimeText(Model.CreatedAtUtc)</span>
            </div>
            <div class="message-body" dir="auto">@Model.Message</div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-primary" href="mailto:@Model.Email?subject=@Uri.EscapeDataString("Re: " + Model.Subject)"><i class="bi bi-reply" aria-hidden="true"></i> @L["Messages.ReplyByEmail"]</a>
                @if (Model.Status != ContactMessageStatus.Replied)
                {
                    <post-button asp-action="Status" asp-route-id="@Model.Id.ToString()" asp-route-status="Replied" text="Messages.MarkReplied" icon="bi-check2-all" class="btn btn-outline-success" />
                }
                @if (Model.Status != ContactMessageStatus.New)
                {
                    <post-button asp-action="Status" asp-route-id="@Model.Id.ToString()" asp-route-status="New" text="Messages.MarkUnread" icon="bi-envelope" class="btn btn-outline-secondary" return-here="false" />
                }
                <post-button asp-action="Delete" asp-route-id="@Model.Id.ToString()" text="Common.Delete" icon="bi-trash" class="btn btn-outline-danger" confirm="Admin.ConfirmDelete" />
            </div>
        </article>
        <form method="post" asp-action="Notes" asp-route-id="@Model.Id" class="admin-card">
            <h2 class="admin-card-title">@L["Messages.InternalNotes"]</h2>
            <label class="visually-hidden" for="notes">@L["Messages.InternalNotes"]</label>
            <textarea class="form-control" id="notes" name="notes" rows="4" maxlength="2000" dir="auto">@Model.AdminNotes</textarea>
            <div class="form-text">@L["Messages.NotesHint"]</div>
            <div class="admin-form-actions"><button class="btn btn-primary" type="submit">@L["Common.Save"]</button></div>
        </form>
    </div>
    <div class="col-xl-4">
        <div class="admin-card">
            <h2 class="admin-card-title">@L["Messages.Sender"]</h2>
            <dl class="admin-dl">
                <dt>@L["Field.Name"]</dt><dd>@Model.Name</dd>
                <dt>@L["Field.Email"]</dt><dd dir="ltr"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                @if (!string.IsNullOrEmpty(Model.Phone)) { <dt>@L["Field.Phone"]</dt><dd dir="ltr">@Model.Phone</dd> }
                @if (!string.IsNullOrEmpty(Model.Organization)) { <dt>@L["Field.Organization"]</dt><dd>@Model.Organization</dd> }
                @if (!string.IsNullOrEmpty(Model.Culture)) { <dt>@L["Messages.Language"]</dt><dd>@(Model.Culture == "en" ? "English" : "العربية")</dd> }
                @if (Model.ReadAtUtc is { } read) { <dt>@L["Messages.ReadAt"]</dt><dd>@Clock.DateTimeText(read)</dd> }
                @if (Model.RepliedAtUtc is { } replied) { <dt>@L["Messages.RepliedAt"]</dt><dd>@Clock.DateTimeText(replied)</dd> }
            </dl>
        </div>
    </div>
</div>
