@model AdminListModel<NationalAirspace.Application.Features.Reports.ReportAdminListItem>
@{ ViewData["Title"] = L["AdminNav.Reports"]; }
@section Actions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Reports.Create"]</a>
}
<partial name="_ListFilter" model="Model.Filter" />
<div class="admin-table-wrap">
    @if (Model.Items.Items.Count == 0)
    {
        <partial name="_TableEmpty" />
    }
    else
    {
        <table class="table admin-table table-hover">
            <thead><tr><th scope="col">@L["Field.Title"]</th><th scope="col">@L["Field.Status"]</th><th scope="col">@L["Field.PublicationDate"]</th><th scope="col">@L["Reports.Downloads"]</th><th scope="col" class="col-actions"><span class="visually-hidden">@L["Admin.Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var x in Model.Items.Items)
                {
                    <tr>
                        <td>
                            <a class="row-title" asp-action="Edit" asp-route-id="@x.Id">@Bilingual.Pick(x.TitleAr, x.TitleEn)</a>
                            <span class="row-sub">
                                @if (x.CategoryAr is not null || x.CategoryEn is not null) { <span><i class="bi bi-tag" aria-hidden="true"></i> @Bilingual.Pick(x.CategoryAr, x.CategoryEn)</span> }
                                @if (!x.HasFile) { <span class="text-danger ms-2"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @L["Reports.NoFile"]</span> }
                            </span>
                        </td>
                        <td data-label="@L["Field.Status"]"><partial name="_StatusBadge" model="new StatusBadgeModel(x.Status)" /></td>
                        <td data-label="@L["Field.PublicationDate"]">@x.PublicationDate.DateOnlyText()</td>
                        <td data-label="@L["Reports.Downloads"]">@x.DownloadCount</td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <partial name="_EditLink" model="x.Id" />
                                <div class="dropdown">
                                    <partial name="_MoreToggle" />
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <partial name="_StatusActions" model="new StatusActionsModel(x.Id, x.Status)" />
                                        <partial name="_RowDelete" model="x.Id" />
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<partial name="_Pager" model="new PagerModel(Model.Items.Page, Model.Items.TotalPages, Context.Request)" />
