@model IReadOnlyList<NationalAirspace.Application.Features.Departments.DepartmentAdminNode>
@{ ViewData["Title"] = L["AdminNav.Departments"]; ViewData["Subtitle"] = L["Departments.Subtitle"]; }
@section Actions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Departments.Create"]</a>
}
@if (Model.Count == 0)
{
    <div class="admin-table-wrap"><partial name="_TableEmpty" /></div>
}
else
{
    <ul class="tree">
        @foreach (var node in Model)
        {
            <partial name="_Node" model="node" />
        }
    </ul>
}
