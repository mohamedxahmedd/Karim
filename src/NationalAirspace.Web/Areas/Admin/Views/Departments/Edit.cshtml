@model AdminFormModel<NationalAirspace.Application.Features.Departments.DepartmentInput>
@{ ViewData["Title"] = Model.IsNew ? L["Departments.Create"] : L["Departments.Edit"]; }
<form method="post" asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.Input.Id" novalidate>
    <input type="hidden" asp-for="Input.ConcurrencyStamp" />
    <div class="row">
        <div class="col-xl-8">
            <div class="admin-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <field asp-for="Input.ParentDepartmentId" type="select" items="Model.Options" empty="Departments.TopLevel" />
                <div class="row">
                    <div class="col-md-6"><field asp-for="Input.NameAr" /></div>
                    <div class="col-md-6"><field asp-for="Input.NameEn" /></div>
                    <div class="col-md-6"><field asp-for="Input.DescriptionAr" type="textarea" rows="4" /></div>
                    <div class="col-md-6"><field asp-for="Input.DescriptionEn" type="textarea" rows="4" /></div>
                </div>
                <field asp-for="Input.Status" type="select" items="L.EnumOptions<ContentStatus>()" />
                <div class="admin-form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @L["Common.Save"]</button>
                    <a class="btn btn-light" asp-action="Index">@L["Common.Cancel"]</a>
                </div>
            </div>
        </div>
    </div>
</form>
