@model AdminListModel<NationalAirspace.Application.Features.Services.ServiceAdminListItem>
@{ ViewData["Title"] = L["AdminNav.Services"]; }
@section Actions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Services.Create"]</a>
}
<partial name="_ListFilter" model="Model.Filter" />
<div class="admin-table-wrap">
    @if (Model.Items.Items.Count == 0)
    {
        <partial name="_TableEmpty" />
    }
    else
    {
        <table class="table admin-table table-hover">
            <thead><tr><th scope="col">@L["Field.Title"]</th><th scope="col">@L["Field.Status"]</th><th scope="col">@L["Admin.Order"]</th><th scope="col">@L["Admin.Updated"]</th><th scope="col" class="col-actions"><span class="visually-hidden">@L["Admin.Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var x in Model.Items.Items)
                {
                    <tr>
                        <td><i class="bi @(x.Icon ?? "bi-grid") text-primary me-1" aria-hidden="true"></i> <a class="row-title" asp-action="Edit" asp-route-id="@x.Id">@Bilingual.Pick(x.TitleAr, x.TitleEn)</a></td>
                        <td data-label="@L["Field.Status"]"><partial name="_StatusBadge" model="new StatusBadgeModel(x.Status)" /></td>
                        <td data-label="@L["Admin.Order"]">@if (!Model.Filter.HasFilter) { <partial name="_MoveButtons" model="x.Id" /> } else { @x.DisplayOrder }</td>
                        <td data-label="@L["Admin.Updated"]" class="text-muted small">@Clock.DateTimeText(x.UpdatedAtUtc)</td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <partial name="_EditLink" model="x.Id" />
                                <div class="dropdown">
                                    <partial name="_MoreToggle" />
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <partial name="_StatusActions" model="new StatusActionsModel(x.Id, x.Status)" />
                                        <partial name="_RowDelete" model="x.Id" />
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<partial name="_Pager" model="new PagerModel(Model.Items.Page, Model.Items.TotalPages, Context.Request)" />
