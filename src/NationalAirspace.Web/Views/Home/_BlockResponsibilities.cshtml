@model HomeBlockModel
@if (Model.Page.Responsibilities.Count > 0)
{
    <section class="section section-alt" id="responsibilities">
        <div class="container container-wide">
            <partial name="_BlockHeader" model="Model.Block" />
            <div class="row g-4">
                @foreach (var s in Model.Page.Responsibilities)
                {
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="card-namc feature-card">
                            <span class="icon-tile"><i class="ph-light @(s.Icon ?? "ph-check-circle")" aria-hidden="true"></i></span>
                            <h3>@s.Title</h3>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
