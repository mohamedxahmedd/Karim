@model HomeBlockModel
@if (Model.Page.Services.Count > 0)
{
    <section class="section" id="services">
        <div class="container container-wide">
            <partial name="_BlockHeader" model="Model.Block" />
            <div class="row g-4">
                @foreach (var s in Model.Page.Services)
                {
                    <div class="col-sm-6 col-lg-3 reveal"><partial name="_ServiceCard" model="s" /></div>
                }
            </div>
        </div>
    </section>
}
