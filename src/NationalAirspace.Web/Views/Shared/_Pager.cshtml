@model PagerModel
@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="@L["Pager.Label"]">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@(Model.Page <= 1 ? "#" : Model.UrlFor(Model.Page - 1))" aria-label="@L["Pager.Previous"]" rel="prev">
                    <i class="bi bi-chevron-@(CultureHelper.CurrentLang == Lang.Ar ? "right" : "left")" aria-hidden="true"></i>
                </a>
            </li>
            @foreach (var p in Model.Window())
            {
                if (p == 0)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Model.UrlFor(p)" @(p == Model.Page ? "aria-current=page" : "")>@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@(Model.Page >= Model.TotalPages ? "#" : Model.UrlFor(Model.Page + 1))" aria-label="@L["Pager.Next"]" rel="next">
                    <i class="bi bi-chevron-@(CultureHelper.CurrentLang == Lang.Ar ? "left" : "right")" aria-hidden="true"></i>
                </a>
            </li>
        </ul>
    </nav>
}
