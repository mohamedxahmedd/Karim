@* Renders CMS page sections, grouping consecutive cards into grids and process steps into a diagram. *@
@model IReadOnlyList<NationalAirspace.Application.Features.Pages.PageSectionDto>
@{
    var groups = new List<(PageSectionLayout Layout, List<NationalAirspace.Application.Features.Pages.PageSectionDto> Items)>();
    foreach (var s in Model)
    {
        if (groups.Count > 0 && groups[^1].Layout == s.Layout && s.Layout is PageSectionLayout.Card or PageSectionLayout.ProcessStep)
            groups[^1].Items.Add(s);
        else
            groups.Add((s.Layout, new() { s }));
    }
}
@foreach (var group in groups)
{
    switch (group.Layout)
    {
        case PageSectionLayout.Card:
            <div class="row g-4 mb-5">
                @foreach (var s in group.Items)
                {
                    <div class="col-md-6 col-lg-@(group.Items.Count % 3 == 0 || group.Items.Count > 4 ? "4" : "6") reveal">
                        <div class="card-namc feature-card" id="@s.Key">
                            <span class="icon-tile"><i class="bi @(s.Icon ?? "bi-check2-circle")" aria-hidden="true"></i></span>
                            <h2 class="h5 mb-0">@s.Title</h2>
                            @if (s.ContentHtml is not null)
                            {
                                <div class="rich-text">@Html.Raw(s.ContentHtml)</div>
                            }
                        </div>
                    </div>
                }
            </div>
            break;
        case PageSectionLayout.ProcessStep:
            <div class="process mb-5 reveal" style="--steps:@group.Items.Count">
                @foreach (var s in group.Items)
                {
                    <div class="process-step">
                        <span class="icon-tile gold"><i class="bi @(s.Icon ?? "bi-arrow-repeat")" aria-hidden="true"></i></span>
                        <h3>@s.Title</h3>
                        @if (s.ContentHtml is not null)
                        {
                            <div class="rich-text">@Html.Raw(s.ContentHtml)</div>
                        }
                    </div>
                }
            </div>
            break;
        default:
            foreach (var s in group.Items)
            {
                var highlight = s.Layout == PageSectionLayout.Highlight;
                <section class="@(highlight ? "vm-card" : "article") mb-4 reveal" id="@s.Key">
                    <div class="row g-4 align-items-center">
                        <div class="@(s.Image is null ? "col-12" : "col-lg-7")">
                            <h2 class="h4 d-flex align-items-center gap-2">
                                @if (s.Icon is not null)
                                {
                                    <span class="icon-tile @(highlight ? "gold" : "")"><i class="bi @s.Icon" aria-hidden="true"></i></span>
                                }
                                @s.Title
                            </h2>
                            @if (s.ContentHtml is not null)
                            {
                                <div class="rich-text">@Html.Raw(s.ContentHtml)</div>
                            }
                        </div>
                        @if (s.Image is not null)
                        {
                            <div class="col-lg-5"><div class="about-visual"><img src="@s.Image.Url" alt="@s.Image.Alt" loading="lazy" /></div></div>
                        }
                    </div>
                </section>
            }
            break;
    }
}
