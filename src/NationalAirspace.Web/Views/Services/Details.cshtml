@model NationalAirspace.Application.Features.Services.ServiceDetailDto
<partial name="_PageHero" />
<section class="section">
    <div class="container container-wide">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-8">
                <article class="article">
                    @if (Model.Image is not null)
                    {
                        <div class="article-cover"><img src="@Model.Image.Url" alt="@Model.Image.Alt" /></div>
                    }
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="icon-tile"><i class="ph-light @(Model.Icon ?? "ph-squares-four")" aria-hidden="true"></i></span>
                        <h2 class="h4 mb-0">@Model.Title</h2>
                    </div>
                    @if (Model.ContentHtml is not null)
                    {
                        <div class="rich-text">@Html.Raw(Model.ContentHtml)</div>
                    }
                    <hr class="my-4" />
                    <a class="btn btn-primary" href="@Url.Site("/contact")"><i class="ph-light ph-chat-circle-dots" aria-hidden="true"></i> @L["Services.Enquire"]</a>
                </article>
            </div>
            <aside class="col-lg-4">
                <div class="sidebar-card">
                    <h2>@L["Services.Other"]</h2>
                    <ul class="sidebar-list">
                        @foreach (var o in Model.Others)
                        {
                            <li><a href="@Url.Site("/services", o.Slug)"><span><i class="ph-light @(o.Icon ?? "ph-squares-four") text-gold" aria-hidden="true"></i> @o.Title</span></a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>
