@model IReadOnlyList<NationalAirspace.Application.Features.Services.ServiceCardDto>
<partial name="_PageHero" />
<section class="section">
    <div class="container container-wide">
        @if (Model.Count == 0)
        {
            <partial name="_EmptyState" model="@("Services.Empty")" />
        }
        else
        {
            <div class="row g-4">
                @foreach (var s in Model)
                {
                    <div class="col-sm-6 col-lg-4 col-xl-3 reveal"><partial name="_ServiceCard" model="s" /></div>
                }
            </div>
        }
    </div>
</section>
