@using NationalAirspace.Application.Features.DemoAirspace
@model DemoSnapshot
@{
    string Icon(DemoLoadLevel l) => l switch { DemoLoadLevel.High => "bi-exclamation-octagon-fill", DemoLoadLevel.Elevated => "bi-exclamation-triangle-fill", _ => "bi-check-circle-fill" };
    const int CellW = 150, CellH = 104, Gap = 12, OffX = 30, OffY = 28;
    (double X, double Y) Center(DemoSector s) => (OffX + s.Column * (CellW + Gap) + CellW / 2.0 + (s.Row % 2 == 1 ? 0 : 40), OffY + s.Row * (CellH + Gap) + CellH / 2.0);
    string Inv(double d) => d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    var byCode = Model.Sectors.ToDictionary(s => s.Code);
    var demandLabel = L["Demo.Demand"].Value;
    var hourlyChart = new BarChartModel("hourly", L["Demo.Hourly"].Value,
        Model.Hourly.Select(h => new BarPoint(h.Hour, h.Demand, $"{h.Hour} — {demandLabel}: {h.Demand}")).ToList(),
        Model.Hourly.FirstOrDefault()?.Capacity, L["Demo.Capacity"].Value);
}
<partial name="_PageHero" />
<section class="section pt-4" id="demo" data-demo-url="@Url.Site("/airspace-demo/data")">
    <div class="container container-wide">
        <div class="demo-banner mb-4" role="note">
            <i class="bi bi-cone-striped" aria-hidden="true"></i>
            <div>
                <div>@L["Demo.Banner"]</div>
                <small class="fw-normal">@L["Demo.BannerDetail"]</small>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3"><div class="kpi"><div class="kpi-label">@L["Demo.KpiFlights"]</div><div class="kpi-value" data-kpi="simulatedFlights">@Model.SimulatedFlights</div></div></div>
            <div class="col-6 col-lg-3"><div class="kpi"><div class="kpi-label">@L["Demo.KpiLoad"]</div><div class="kpi-value"><span data-kpi="averageLoadPercent">@Model.AverageLoadPercent</span>%</div></div></div>
            <div class="col-6 col-lg-3"><div class="kpi"><div class="kpi-label">@L["Demo.KpiMeasures"]</div><div class="kpi-value" data-kpi="activeMeasures">@Model.ActiveMeasures</div></div></div>
            <div class="col-6 col-lg-3"><div class="kpi"><div class="kpi-label">@L["Demo.KpiOnTime"]</div><div class="kpi-value"><span data-kpi="onTimePercent">@Model.OnTimePercent</span>%</div></div></div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="panel">
                    <div class="panel-title">
                        <span><i class="bi bi-map" aria-hidden="true"></i> @L["Demo.Map"]</span>
                        <small class="text-muted fw-normal">@L["Demo.UpdatedAt"] <span data-generated>@Clock.ToSiteTime(Model.GeneratedAtUtc).ToString("HH:mm:ss")</span></small>
                    </div>
                    <svg class="airspace-map" viewBox="0 0 720 400" role="img" aria-label="@L["Demo.MapAria"]" direction="ltr">
                        <defs><pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="#ffffff" stroke-opacity=".05" /></pattern></defs>
                        <rect width="720" height="400" fill="url(#grid)" />
                        @foreach (var s in Model.Sectors)
                        {
                            var (cx, cy) = Center(s);
                            <g class="lvl-@s.Level" data-sector="@s.Code" data-tip="@s.Name — @s.Demand / @s.Capacity (@s.LoadPercent%) — @L.Enum(s.Level)">
                                <rect class="sector lvl-@s.Level" x="@Inv(cx - CellW / 2.0)" y="@Inv(cy - CellH / 2.0)" width="@CellW" height="@CellH" rx="14" />
                                <text class="sector-label" x="@Inv(cx)" y="@Inv(cy - 6)">@s.Code</text>
                                <text class="sector-load" x="@Inv(cx)" y="@Inv(cy + 16)" data-load>@s.LoadPercent%</text>
                            </g>
                        }
                        @foreach (var f in Model.Flows)
                        {
                            if (!byCode.TryGetValue(f.From, out var a) || !byCode.TryGetValue(f.To, out var b)) continue;
                            var (x1, y1) = Center(a);
                            var (x2, y2) = Center(b);
                            var flowPath = $"M{Inv(x1)},{Inv(y1)} Q{Inv((x1 + x2) / 2 + 30)},{Inv((y1 + y2) / 2 - 30)} {Inv(x2)},{Inv(y2)}";
                            <path class="flow" d="@flowPath" stroke-width="@Inv(1 + f.Volume / 8.0)" />
                        }
                    </svg>
                    <div class="legend mt-3">
                        <span><i style="background:var(--status-good)"></i><span class="bi bi-check-circle-fill" aria-hidden="true"></span> @L.Enum(DemoLoadLevel.Normal) (&lt;70%)</span>
                        <span><i style="background:var(--status-warning)"></i><span class="bi bi-exclamation-triangle-fill" aria-hidden="true"></span> @L.Enum(DemoLoadLevel.Elevated) (70–89%)</span>
                        <span><i style="background:var(--status-critical)"></i><span class="bi bi-exclamation-octagon-fill" aria-hidden="true"></span> @L.Enum(DemoLoadLevel.High) (≥90%)</span>
                        <span><i style="background:var(--namc-gold-400)"></i> @L["Demo.FlowLegend"]</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="panel">
                    <div class="panel-title"><span><i class="bi bi-speedometer2" aria-hidden="true"></i> @L["Demo.SectorStatus"]</span></div>
                    @foreach (var s in Model.Sectors)
                    {
                        <div class="bar-row" data-sector-row="@s.Code">
                            <span class="text-truncate">@s.Name</span>
                            <div class="bar-track"><div class="bar-fill lvl-bg-@s.Level" style="width:@Math.Min(100, s.LoadPercent)%"></div></div>
                            <span class="fw-600 ltr-nums" data-load><i class="bi @Icon(s.Level)" aria-hidden="true"></i> @s.LoadPercent%</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="panel">
                    <div class="panel-title"><span><i class="bi bi-bar-chart" aria-hidden="true"></i> @L["Demo.Hourly"]</span></div>
                    <partial name="_BarChart" model="hourlyChart" />
                    <details class="mt-2">
                        <summary class="small text-muted">@L["Common.ShowTable"]</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm">
                                <thead><tr><th>@L["Demo.Hour"]</th><th>@L["Demo.Demand"]</th><th>@L["Demo.Capacity"]</th></tr></thead>
                                <tbody>
                                    @foreach (var h in Model.Hourly)
                                    {
                                        <tr><td>@h.Hour</td><td>@h.Demand</td><td>@h.Capacity</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="panel mb-4">
                    <div class="panel-title"><span><i class="bi bi-bell" aria-hidden="true"></i> @L["Demo.Notifications"]</span></div>
                    <div data-notifications>
                        @foreach (var n in Model.Notifications)
                        {
                            <div class="notif @n.Severity"><i class="bi @(n.Severity == "warning" ? "bi-exclamation-triangle" : n.Severity == "info" ? "bi-info-circle" : "bi-shield-check")" aria-hidden="true"></i><span>@n.Message</span></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="panel mt-4">
            <div class="panel-title"><span><i class="bi bi-building" aria-hidden="true"></i> @L["Demo.Airports"]</span></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>@L["Demo.Airport"]</th><th>@L["Demo.Arrivals"]</th><th>@L["Demo.Departures"]</th><th>@L["Demo.Capacity"]</th><th>@L["Demo.Delay"]</th><th>@L["Demo.Status"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Airports)
                        {
                            <tr data-airport="@a.Code">
                                <td><strong>@a.Code</strong> <span class="text-muted">@a.Name</span></td>
                                <td data-f="arrivals">@a.Arrivals</td>
                                <td data-f="departures">@a.Departures</td>
                                <td>@a.Capacity</td>
                                <td data-f="averageDelayMinutes">@a.AverageDelayMinutes</td>
                                <td data-f="level"><i class="bi @Icon(a.Level) text-@(a.Level == DemoLoadLevel.High ? "danger" : a.Level == DemoLoadLevel.Elevated ? "warning" : "success")" aria-hidden="true"></i> @L.Enum(a.Level)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="text-muted small mt-3 mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> @L["Demo.Footnote"]</p>
    </div>
</section>
<template id="level-labels" data-normal="@L.Enum(DemoLoadLevel.Normal)" data-elevated="@L.Enum(DemoLoadLevel.Elevated)" data-high="@L.Enum(DemoLoadLevel.High)"></template>
@section Scripts {
    <script src="~/js/viz.js" asp-append-version="true"></script>
    <script src="~/js/demo.js" asp-append-version="true"></script>
}
