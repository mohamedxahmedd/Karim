@model NationalAirspace.Application.Features.Pages.PageDto
<partial name="_PageHero" />
<section class="section">
    <div class="container container-wide">
        @if (Model.HeroImage is not null || Model.ContentHtml is not null)
        {
            <div class="article mb-5 reveal">
                @if (Model.HeroImage is not null)
                {
                    <div class="article-cover"><img src="@Model.HeroImage.Url" alt="@Model.HeroImage.Alt" /></div>
                }
                @if (Model.ContentHtml is not null)
                {
                    <div class="rich-text">@Html.Raw(Model.ContentHtml)</div>
                }
            </div>
        }
        <partial name="_Sections" model="Model.Sections" />
        <p class="text-muted small mt-4 mb-0"><i class="ph-light ph-clock-counter-clockwise" aria-hidden="true"></i> @L["Common.LastUpdated"]: @Clock.LongDate(Model.UpdatedAtUtc)</p>
    </div>
</section>
